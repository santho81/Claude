{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "@cucumber/cucumber", "chai"],
    "outDir": "dist"
  },
  "include": [
    "step-definitions/**/*.ts",
    "support/**/*.ts"
  ]
}
